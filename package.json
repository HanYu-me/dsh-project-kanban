{
  "name": "dsh-project-kanban",
  "description": "Project kanban for the DeepSeek Harness (dsh) web GUI: a sidebar entry opens a board grouped by project, each with four fixed columns (待办 / 进行中 / 待反馈 / 已完成). Add projects and tasks; one click advances a task to the next column.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react-dom"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "~0.25.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kanban",
    "project-board",
    "todo"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/build.mjs",
    "typecheck": "tsc -p . --pretty false",
    "test": "vitest run"
  },
  "author": "Yu Han",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanYu-me/dsh-project-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/HanYu-me/dsh-project-kanban/issues"
  },
  "homepage": "https://github.com/HanYu-me/dsh-project-kanban#readme"
}
